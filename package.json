{
  "name": "sunday-board",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "format": "oxfmt -c oxfmt.config.ts",
    "format:check": "oxfmt --check -c oxfmt.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "prepare": "husky && (svelte-kit sync || echo '')",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "db:push": "prisma push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate",
    "db:studio": "prisma studio",
    "auth:schema": "better-auth generate --config src/lib/server/auth.ts --output prisma/auth.prisma --yes"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/sveltekit": "^10.69.0",
    "better-auth": "^1.6.26",
    "nanoid": "^6.0.1",
    "pg": "^8.22.0",
    "posthog-js": "^1.413.2",
    "posthog-node": "^5.48.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@types/pg": "^8.20.4",
    "@vitest/browser-playwright": "^4.1.10",
    "auth": "^1.6.26",
    "better-auth": "^1.6.26",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "phosphor-svelte": "^3.1.0",
    "playwright": "^1.62.1",
    "postgres": "^3.4.9",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-sonner": "^1.1.1",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "valibot": "^1.4.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  },
  "volta": {
    "node": "24.18.0"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.0": true,
    "@prisma/engines@7.9.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
